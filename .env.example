# Copy to `.env` (or `.env.local`) and adjust. Everything is read through utils/config.ts.

# ODOS backend origin, no trailing slash and no "/api". Used by server rendering and the Next.js proxy.
NEXT_PUBLIC_API_BASE_URL=https://appbe.odos.market

# This site's own public origin (used for metadata, OG URLs, robots and sitemap). Never the API.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
