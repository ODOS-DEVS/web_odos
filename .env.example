# Copy to `.env` (or `.env.local`) and adjust. Everything is read through utils/config.ts.

# ODOS backend origin, no trailing slash and no "/api". Used by server rendering and the Next.js proxy.
NEXT_PUBLIC_API_BASE_URL=https://appbe.odos.market

# This site's own public origin (used for metadata, OG URLs, robots and sitemap). Never the API.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth **web** client id, for "Continue with Google". Public by design (it ships in the
# browser bundle), but the origin you serve from must be listed as an "Authorized JavaScript origin"
# on this client in the Google Cloud console, or Google refuses to issue a token for it.
# Leave unset and the button explains itself instead of failing on click.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
